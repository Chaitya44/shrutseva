{
  "rewrites": [
    {
      "source": "/api/proxyLogin",
      "destination": "/api/proxyLogin"
    },
    {
      "source": "/api/:path*",
      "destination": "https://www.shrutseva.com/test/api/:path*"
    },
    {
      "source": "/login",
      "destination": "https://www.shrutseva.com/test/login"
    },
    {
      "source": "/front_login",
      "destination": "https://www.shrutseva.com/test/front_login"
    },
    {
      "source": "/get_bhandars_list",
      "destination": "https://www.shrutseva.com/test/get_bhandars_list"
    },
    {
      "source": "/front/:path*",
      "destination": "https://www.shrutseva.com/test/front/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
